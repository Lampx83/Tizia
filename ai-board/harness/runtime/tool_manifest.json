{
  "version": 5,
  "tools": [
    {
      "name": "tree",
      "description": "List the files and direct subfolders of one folder at the base sha.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      },
      "effect": "read",
      "max_arg_bytes": 1000,
      "max_output_chars": 16000,
      "max_seconds": 10,
      "example": {
        "path": "public"
      }
    },
    {
      "name": "outline",
      "description": "Outline of one file: tags/ids/classes, CSS selectors, JS exports/imports, and the page's linked css/js.",
      "parameters": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          }
        },
        "required": [
          "file"
        ]
      },
      "effect": "read",
      "max_arg_bytes": 1000,
      "max_output_chars": 16000,
      "max_seconds": 10,
      "example": {
        "file": "public/index.html"
      }
    },
    {
      "name": "grep",
      "description": "Window of lines around keywords in one file; with no file, list the files matching in path.",
      "parameters": {
        "type": "object",
        "properties": {
          "words": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "file": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "words"
        ]
      },
      "effect": "read",
      "max_arg_bytes": 2000,
      "max_output_chars": 16000,
      "max_seconds": 10,
      "example": {
        "words": [
          "login",
          "signup"
        ],
        "file": "public/index.html"
      }
    },
    {
      "name": "read_file",
      "description": "Read the target file (with `Lnn| ` prefixes). Optional start_line/end_line (1-based, inclusive) pick a window; without them you get the head plus the total line count and how to continue.",
      "parameters": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "start_line": {
            "type": "integer"
          },
          "end_line": {
            "type": "integer"
          }
        },
        "required": [
          "file"
        ]
      },
      "effect": "read",
      "max_arg_bytes": 500,
      "max_output_chars": 16000,
      "max_seconds": 5,
      "example": {
        "file": "public/index.html",
        "start_line": 1,
        "end_line": 40
      }
    },
    {
      "name": "read_skill_resource",
      "description": "Read one file under references/ of an active skill, as <skill>/references/<file>. Allowed only when the skill body mentions that file; scripts/ is never readable or run.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      },
      "effect": "read",
      "max_arg_bytes": 500,
      "max_output_chars": 16000,
      "max_seconds": 5
    },
    {
      "name": "edit_file",
      "description": "Apply edits {after_line, insert} or {search, replace} to the target file; line numbers follow the current draft.",
      "parameters": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "edits": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "file",
          "edits"
        ]
      },
      "effect": "draft_write",
      "max_arg_bytes": 60000,
      "max_output_chars": 4000,
      "max_seconds": 90,
      "example": {
        "file": "public/index.html",
        "edits": [
          {
            "after_line": 12,
            "insert": "<p>Hello</p>"
          }
        ]
      }
    },
    {
      "name": "write_test",
      "description": "Set the test (ESM node:test) under test/.",
      "parameters": {
        "type": "object",
        "properties": {
          "test_file": {
            "type": "string"
          },
          "test": {
            "type": "string"
          }
        },
        "required": [
          "test_file",
          "test"
        ]
      },
      "effect": "draft_write",
      "max_arg_bytes": 60000,
      "max_output_chars": 500,
      "max_seconds": 5,
      "example": {
        "test_file": "test/index.test.js",
        "test": "import test from 'node:test';\n// public/index.html\n"
      }
    },
    {
      "name": "run_check",
      "description": "Run a named check on the current draft in a network-less sandbox: light, platform or relevant. Takes no shell/argv.",
      "parameters": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string"
          }
        },
        "required": [
          "profile"
        ]
      },
      "effect": "read",
      "max_arg_bytes": 100,
      "max_output_chars": 4000,
      "max_seconds": 90,
      "example": {
        "profile": "light"
      }
    },
    {
      "name": "request_package",
      "description": "Ask the admin to approve an npm package you need. The run pauses until a decision; a rejection comes back as `denied: <reason>`. Never edit package.json yourself.",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version_range": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "version_range",
          "reason"
        ]
      },
      "effect": "control",
      "max_arg_bytes": 1000,
      "max_output_chars": 2000,
      "max_seconds": 10
    },
    {
      "name": "fetch_url",
      "description": "Ask to read one external documentation URL. The run pauses until a decision; a rejection comes back as `denied: <reason>`.",
      "parameters": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "reason"
        ]
      },
      "effect": "control",
      "max_arg_bytes": 1000,
      "max_output_chars": 16000,
      "max_seconds": 10
    },
    {
      "name": "finish",
      "description": "Propose finishing; the harness checks, then passes to the next gates.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "effect": "control",
      "max_arg_bytes": 100,
      "max_output_chars": 500,
      "max_seconds": 100,
      "example": {}
    }
  ],
  "command_policy": {
    "allow": [
      [
        "git",
        "status"
      ],
      [
        "git",
        "diff"
      ],
      [
        "git",
        "log"
      ],
      [
        "git",
        "show"
      ],
      [
        "git",
        "ls-files"
      ],
      [
        "git",
        "rev-parse"
      ],
      [
        "node",
        "--test"
      ],
      [
        "npm",
        "test"
      ],
      [
        "npm",
        "run",
        "check:content"
      ],
      [
        "python",
        "-m",
        "pytest"
      ]
    ],
    "deny_args": [
      "npx",
      "install",
      "add",
      "-r",
      "-rf",
      "-fr",
      "--recursive",
      "--force"
    ],
    "deny_sql": [
      "DROP",
      "TRUNCATE"
    ],
    "deny_write": [
      "package-lock.json",
      "*.lock",
      "yarn.lock",
      "pnpm-lock.yaml",
      "dist/*",
      "*/generated/*",
      "generated/*"
    ]
  },
  "check_runtime_sha256": "09cf985b0b1682d0254d858e507aaeb92de40b8342e513992d7c36fdda272414"
}
