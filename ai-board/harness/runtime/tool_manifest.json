{
  "version": 4,
  "tools": [
    {
      "name": "tree",
      "description": "Liệt kê file/thư mục con trực tiếp của 1 thư mục ở base sha.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      },
      "effect": "read",
      "max_arg_bytes": 1000,
      "max_output_chars": 2000,
      "max_seconds": 10
    },
    {
      "name": "outline",
      "description": "Dàn ý 1 file: thẻ/id/class, selector CSS, export/import JS, css/js trang liên kết.",
      "parameters": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          }
        },
        "required": [
          "file"
        ]
      },
      "effect": "read",
      "max_arg_bytes": 1000,
      "max_output_chars": 2000,
      "max_seconds": 10
    },
    {
      "name": "grep",
      "description": "Cửa sổ dòng quanh từ khoá trong 1 file; không có file thì liệt kê file khớp trong path.",
      "parameters": {
        "type": "object",
        "properties": {
          "words": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "file": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "words"
        ]
      },
      "effect": "read",
      "max_arg_bytes": 2000,
      "max_output_chars": 2000,
      "max_seconds": 10
    },
    {
      "name": "read_file",
      "description": "Đọc file đích (có tiền tố `Lnn| `).",
      "parameters": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          }
        },
        "required": [
          "file"
        ]
      },
      "effect": "read",
      "max_arg_bytes": 500,
      "max_output_chars": 2000,
      "max_seconds": 5
    },
    {
      "name": "edit_file",
      "description": "Áp edits {after_line, insert} hoặc {search, replace} lên file đích; số dòng theo bản đang giữ.",
      "parameters": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "edits": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "file",
          "edits"
        ]
      },
      "effect": "draft_write",
      "max_arg_bytes": 60000,
      "max_output_chars": 4000,
      "max_seconds": 90
    },
    {
      "name": "write_test",
      "description": "Đặt test (ESM node:test) trong test/.",
      "parameters": {
        "type": "object",
        "properties": {
          "test_file": {
            "type": "string"
          },
          "test": {
            "type": "string"
          }
        },
        "required": [
          "test_file",
          "test"
        ]
      },
      "effect": "draft_write",
      "max_arg_bytes": 60000,
      "max_output_chars": 500,
      "max_seconds": 5
    },
    {
      "name": "run_check",
      "description": "Chạy named check trên draft hiện tại trong sandbox không mạng: light, platform hoặc relevant. Không nhận shell/argv.",
      "parameters": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string"
          }
        },
        "required": [
          "profile"
        ]
      },
      "effect": "read",
      "max_arg_bytes": 100,
      "max_output_chars": 4000,
      "max_seconds": 90
    },
    {
      "name": "finish",
      "description": "Đề xuất kết thúc; harness kiểm rồi mới chuyển sang các cổng sau.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "effect": "control",
      "max_arg_bytes": 100,
      "max_output_chars": 500,
      "max_seconds": 100
    }
  ],
  "command_policy": {
    "allow": [
      [
        "git",
        "status"
      ],
      [
        "git",
        "diff"
      ],
      [
        "git",
        "log"
      ],
      [
        "git",
        "show"
      ],
      [
        "git",
        "ls-files"
      ],
      [
        "git",
        "rev-parse"
      ],
      [
        "node",
        "--test"
      ],
      [
        "npm",
        "test"
      ],
      [
        "npm",
        "run",
        "check:content"
      ],
      [
        "python",
        "-m",
        "pytest"
      ]
    ],
    "deny_args": [
      "npx",
      "install",
      "add",
      "-r",
      "-rf",
      "-fr",
      "--recursive",
      "--force"
    ],
    "deny_sql": [
      "DROP",
      "TRUNCATE"
    ],
    "deny_write": [
      "package-lock.json",
      "*.lock",
      "yarn.lock",
      "pnpm-lock.yaml",
      "dist/*",
      "*/generated/*",
      "generated/*"
    ]
  },
  "check_runtime_sha256": "5b477b47b54f64c5b94faa734b6e0dd00c5e8e0140f256b2ebf8e858a385d861"
}
