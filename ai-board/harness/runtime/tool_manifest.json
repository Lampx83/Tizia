{
  "version": 4,
  "tools": [
    {
      "name": "tree",
      "description": "List the files and direct subfolders of one folder at the base sha.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      },
      "effect": "read",
      "max_arg_bytes": 1000,
      "max_output_chars": 2000,
      "max_seconds": 10
    },
    {
      "name": "outline",
      "description": "Outline of one file: tags/ids/classes, CSS selectors, JS exports/imports, and the page's linked css/js.",
      "parameters": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          }
        },
        "required": [
          "file"
        ]
      },
      "effect": "read",
      "max_arg_bytes": 1000,
      "max_output_chars": 2000,
      "max_seconds": 10
    },
    {
      "name": "grep",
      "description": "Window of lines around keywords in one file; with no file, list the files matching in path.",
      "parameters": {
        "type": "object",
        "properties": {
          "words": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "file": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "words"
        ]
      },
      "effect": "read",
      "max_arg_bytes": 2000,
      "max_output_chars": 2000,
      "max_seconds": 10
    },
    {
      "name": "read_file",
      "description": "Read the target file (with `Lnn| ` prefixes).",
      "parameters": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          }
        },
        "required": [
          "file"
        ]
      },
      "effect": "read",
      "max_arg_bytes": 500,
      "max_output_chars": 2000,
      "max_seconds": 5
    },
    {
      "name": "edit_file",
      "description": "Apply edits {after_line, insert} or {search, replace} to the target file; line numbers follow the current draft.",
      "parameters": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "edits": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "file",
          "edits"
        ]
      },
      "effect": "draft_write",
      "max_arg_bytes": 60000,
      "max_output_chars": 4000,
      "max_seconds": 90
    },
    {
      "name": "write_test",
      "description": "Set the test (ESM node:test) under test/.",
      "parameters": {
        "type": "object",
        "properties": {
          "test_file": {
            "type": "string"
          },
          "test": {
            "type": "string"
          }
        },
        "required": [
          "test_file",
          "test"
        ]
      },
      "effect": "draft_write",
      "max_arg_bytes": 60000,
      "max_output_chars": 500,
      "max_seconds": 5
    },
    {
      "name": "run_check",
      "description": "Run a named check on the current draft in a network-less sandbox: light, platform or relevant. Takes no shell/argv.",
      "parameters": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string"
          }
        },
        "required": [
          "profile"
        ]
      },
      "effect": "read",
      "max_arg_bytes": 100,
      "max_output_chars": 4000,
      "max_seconds": 90
    },
    {
      "name": "finish",
      "description": "Propose finishing; the harness checks, then passes to the next gates.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "effect": "control",
      "max_arg_bytes": 100,
      "max_output_chars": 500,
      "max_seconds": 100
    }
  ],
  "command_policy": {
    "allow": [
      [
        "git",
        "status"
      ],
      [
        "git",
        "diff"
      ],
      [
        "git",
        "log"
      ],
      [
        "git",
        "show"
      ],
      [
        "git",
        "ls-files"
      ],
      [
        "git",
        "rev-parse"
      ],
      [
        "node",
        "--test"
      ],
      [
        "npm",
        "test"
      ],
      [
        "npm",
        "run",
        "check:content"
      ],
      [
        "python",
        "-m",
        "pytest"
      ]
    ],
    "deny_args": [
      "npx",
      "install",
      "add",
      "-r",
      "-rf",
      "-fr",
      "--recursive",
      "--force"
    ],
    "deny_sql": [
      "DROP",
      "TRUNCATE"
    ],
    "deny_write": [
      "package-lock.json",
      "*.lock",
      "yarn.lock",
      "pnpm-lock.yaml",
      "dist/*",
      "*/generated/*",
      "generated/*"
    ]
  },
  "check_runtime_sha256": "5b477b47b54f64c5b94faa734b6e0dd00c5e8e0140f256b2ebf8e858a385d861"
}
