# ============================================================
# Tizia — biến môi trường mẫu. Copy thành `.env` và điền giá trị thật.
# ============================================================

# ── Server ──
# PORT=8041
# HOST=0.0.0.0
# BASE_PATH=                       # nếu deploy sau reverse-proxy sub-path, vd "/ps"

# ── Observability / Logging / Error tracking ──
# LOG_LEVEL=info                   # debug|info|warn|error (mặc định info ở prod)
# LOG_REQUESTS=0                   # =1 để log mỗi request /api/* (status + thời gian)
# EXIT_ON_UNCAUGHT=1               # =0 để KHÔNG thoát khi uncaughtException (không khuyến nghị)
# Sentry (tuỳ chọn) — bỏ trống thì lỗi chỉ log ra stdout. Bật: set DSN + `npm i @sentry/node`.
# SENTRY_DSN=
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0

# ── Database (Postgres) ──
# Local dev: `docker compose up -d tizia-postgres` → DB ở 127.0.0.1:5433
# Prod: container tizia-postgres trong network 126_default, host=tizia-postgres
DATABASE_URL=postgres://tizia:tizia_dev_pw@127.0.0.1:5433/tizia
# POSTGRES_PASSWORD=tizia_dev_pw   # password mạnh ở prod, đừng commit

# ── Backup / Restore (admin → /api/admin/backups) ──
# pg_dump/pg_restore phải cùng major version với server Postgres. Mac có brew
# postgresql@14 trong PATH mặc định — nếu server là pg16 thì set tay:
# PG_DUMP_BIN=/opt/homebrew/Cellar/postgresql@16/16.14/bin/pg_dump
# PG_RESTORE_BIN=/opt/homebrew/Cellar/postgresql@16/16.14/bin/pg_restore
# BACKUP_DIR=./data/backups        # đổi mount khi prod muốn lưu ra volume riêng
# BACKUP_HOUR=3                    # giờ auto-snapshot (server time, 0–23)
# BACKUP_KEEP=7                    # giữ N file gần nhất
# BACKUP_MAX_BYTES=524288000       # giới hạn file upload restore (500 MB)

# ── Google Analytics 4 ──
# Lấy ở admin.google.com/analytics → Admin → Data Streams → Web → chọn stream
# Measurement ID có dạng G-XXXXXXX (10 ký tự sau G-)
GA_MEASUREMENT_ID=

# API secret cho Measurement Protocol (server-side event: quiz_submit, ai_chat,
# badge_unlock). Tạo ở: Data Streams → Web → Measurement Protocol API secrets
# → Create. KHÔNG commit secret thật vào git.
GA_API_SECRET=

# Bật GA_DEBUG=1 để in log mỗi lần server bắn event + dùng debug endpoint của
# GA4 (xem validation). Tắt ở production.
# GA_DEBUG=0

# ── AI / Ollama ──
# BẮT BUỘC nếu muốn /api/ai/* hoạt động — server/ai.js KHÔNG còn fallback cứng
# trong code (trước có 1 endpoint dev-tunnel + secret nằm thẳng trong source,
# đã bỏ vì đó là rò rỉ). Thiếu URL/MODEL thì route trả 503, không âm thầm gọi
# nhầm đâu đó. Hỏi devops (dev kia) giá trị thật — endpoint đi qua reverse-proxy
# nội bộ, không phải Ollama trần expose thẳng.
# OLLAMA_URL=http://<host>:<port>/ollama/api
# OLLAMA_SECKEY=<hỏi devops>          # header x-ollama-seckey — có thể không cần
#                                     # nếu gateway không yêu cầu
# OLLAMA_MODEL=qwen2.5:14b-instruct-ctx16k
# OLLAMA_TIMEOUT_MS=60000

# ── Payment (Phase 1) ──
# PAYMENT_ENABLED=0                # đặt =1 để bật route /api/payment/*

# ── ScoreUp Public API (nguồn duy nhất cho câu hỏi trắc nghiệm) ──
# Spec: https://fit.neu.edu.vn/scoreup/v1/api/public/docs (v1.4.0)
# Key cấp qua: docker compose exec api node scripts/create-api-client.js (trên repo ScoreUp)
SCOREUP_BASE_URL=https://fit.neu.edu.vn/scoreup/v1/api/public
SCOREUP_API_KEY=                       # sk_scoreup_partner_<32+hex>, server-side only
SCOREUP_WEBHOOK_SECRET=                # random ≥16 ký tự, dùng khi register webhook

# ── Codelab API (bài tập lập trình + chạy code) ──
# Spec: https://fit.neu.edu.vn/codelab/api-backend/docs
# Cấp key: super-admin (lampx/quocthai/mainq/thaop) POST /api-keys với scope:
#   [problems:read, submissions:write, submissions:read, languages:read,
#    contests:read]; ipWhitelist ["101.96.66.232"]; rateLimitPerMinute 300;
#   defaultCallbackUrl "https://tizia.vn/api/webhooks/codelab".
# Response trả rawKey + webhookSecret CHỈ HIỆN 1 LẦN — bỏ vào đây ngay.
CODELAB_BASE_URL=https://fit.neu.edu.vn/codelab/api-backend
CODELAB_API_KEY=                       # clb_live_<prefix>_<raw32>, server-side only
CODELAB_WEBHOOK_SECRET=                # plaintext từ response create key, verify HMAC
# CODELAB_CACHE_TTL_MS=300000          # mặc định 5 phút cho list/detail
# CODELAB_TIMEOUT_MS=20000             # fetch timeout, bài lớn có thể cần nâng

# ── Hộp thư Ban điều hành AI (route đọc-chỉ /api/ai-board/inbox) ──
# Cho phép routine "Ban điều hành AI" (chạy ngoài server, không đăng nhập được)
# đọc các yêu cầu pending/reviewing của HS/SV. ĐỂ TRỐNG = route KHÔNG tồn tại (404).
# Key phải ≥24 ký tự, nếu ngắn hơn server từ chối bật và ghi cảnh báo.
#   Sinh key:  openssl rand -hex 32
# ⚠ Dữ liệu trả về gồm tên hiển thị + nội dung yêu cầu của người học → coi key này
#   nhạy cảm ngang mật khẩu admin. KHÔNG commit, chỉ đặt qua env.
AI_BOARD_KEY=                          # ≥24 ký tự; trống = tắt tính năng

# D0 worker key tách biệt với key inbox đọc-chỉ. Worker chỉ được thao tác
# ticket mà chính nó đang giữ lease; không có quyền admin/merge/SQL.
AI_BOARD_WORKER_KEY=                   # ≥24 ký tự; trống = worker API không mount
# AI_BOARD_WORKER_MODE=off             # off | shadow; off là mặc định
# AI_BOARD_WORKER_ID=local-worker-1
# AI_BOARD_WORKER_VERSION=d0
# TIZIA_URL=http://127.0.0.1:8041

# ── Legacy reverse-proxy (deprecated, sẽ gỡ) ──
# SCOREUP_TARGET=http://127.0.0.1:3000
# CODELAB_TARGET=http://127.0.0.1:8024
# SMARTDOC_TARGET=http://127.0.0.1:8017
# FEEDBACKME_TARGET=http://127.0.0.1:8020

# ── AI Board Harness (ai-board/harness/, process Python riêng — đọc THẲNG
#    file .env gốc này qua python-dotenv, không phải file mẫu riêng) ──
# Dùng CHUNG OLLAMA_URL/OLLAMA_SECKEY ở mục "AI / Ollama" phía trên — cùng 1
# reverse-proxy nội bộ server/ai.js đang gọi, không phải endpoint riêng cho
# harness. GATE1_MODEL/GATE3_MODEL/EMBED_MODEL là TÊN MODEL trên gateway đó
# (khác OLLAMA_MODEL của AITutor — cùng gateway, chạy model khác nhau theo vai).
# GATE1_MODEL=gemma4:26b                 # phán đoán + plan + validator
# GATE3_MODEL=qwen3-coder:30b            # implement
# EMBED_MODEL=bge-m3                     # gom feedback trùng
# TIZIA_INBOX_PATH=./ai-board/inbox.json # snapshot JSON, không đọc thẳng .db
# TIZIA_DB_PATH=./data/tizia.db          # nơi harness ghi skill_proposals (chỉ ghi bảng này)
# BUDGET_MAX_MODEL_CALLS=40              # Complexity Budget — chạm trần là dừng,
# BUDGET_MAX_TOOL_CALLS=200              #   outcome='budget_exhausted', cộng dồn
# BUDGET_MAX_TOKENS=200000               #   qua các lần resume chứ không reset
# BUDGET_MAX_RETRIES=3
# BUDGET_MAX_WALL_CLOCK_S=900
# GIT_DEPLOY_KEY_PATH=~/.ssh/tizia-ai-board  # scope hẹp, chỉ push branch
# GITHUB_TOKEN=                          # dùng cho `gh pr create`
# TELEGRAM_BOT_TOKEN=                    # báo ca critical, xem Sổ Tay mục 03
# TELEGRAM_CHAT_ID=
# DRY_RUN=1                              # 1 = không mở PR/gọi Telegram thật, dùng khi test local
# PRESCREEN=1                            # 0 = bỏ bước gom trùng + chấm ưu tiên (bge-m3) trước cổng 1
