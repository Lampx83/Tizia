# Prompt gửi model phải byte-để-byte giống nhau trên mọi OS (kỷ luật cache,
# spec.md rule 1) — autocrlf=true trên Windows biến LF thành CRLF trong working
# tree, đổi prefix gửi Ollama và làm prompts.lock.json lệch hash.
ai-board/harness/prompts/*.md text eol=lf
ai-board/harness/skills/*/SKILL.md text eol=lf
scripts/smoke-user-state.sh text eol=lf
ai-board/worker-entrypoint.sh text eol=lf
# Shell scripts and guest build files run on Linux (containers, microVM); CRLF breaks the shebang line.
*.sh text eol=lf
ai-board/sandbox-runner/guest/Dockerfile* text eol=lf
ai-board/sandbox-runner/sandbox-policy*.yaml text eol=lf
